        <mxCell id="heading" value="3. Circuit Discovery — run_eap_multitokens.py (EAP-IG)" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1000" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="subheading" value="Edge Attribution Patching with Integrated Gradients over the fine-tuned model. Every candidate edge of the transformer's computational graph is scored by how much it moves &lt;i&gt;logit_diff&lt;/i&gt; between the clean and corrupted prompt; the top-k edges form the circuit, whose faithfulness is then measured by re-running the model with all other edges patched to their corrupted activations." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="64" width="1000" height="60" as="geometry"/>
        </mxCell>
