        </mxCell>
        <mxCell id="cd-sh-3" value="ig_steps = 5, batch_size = 5" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" parent="cd-sh" vertex="1">
