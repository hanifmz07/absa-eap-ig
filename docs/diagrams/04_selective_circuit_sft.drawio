        <mxCell id="heading" value="4. Selective Circuit-Based SFT — run_sft.py --circuit_csv_path" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1000" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="subheading" value="The same training loop as Full SFT, but every parameter outside the discovered circuit is held fixed. Freezing is done with backward hooks that zero the gradient of inactive attention heads, so the optimizer sees updates only for the heads named in the circuit CSV. A random-circuit control of the same size is available via --random_circuit." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="64" width="1000" height="60" as="geometry"/>
        </mxCell>
